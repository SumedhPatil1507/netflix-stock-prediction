# Copy this to .env and fill in your values
# Never commit .env to git

# ── Data Sources ──────────────────────────────────────────────────────────────
# Alpha Vantage — free tier: 25 req/day, intraday + daily
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Alpaca Markets — free paper trading, minute bars
# Get keys at: https://app.alpaca.markets/paper-trading
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Broker Execution ──────────────────────────────────────────────────────────
# Set ALPACA_BASE_URL to live URL for real trading (use with extreme caution)
# ALPACA_BASE_URL=https://api.alpaca.markets

# ── Alerts & Monitoring ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
ALERT_EMAIL=alerts@yourdomain.com

# ── API Settings ──────────────────────────────────────────────────────────────
API_RATE_LIMIT=10

# ── Pipeline ──────────────────────────────────────────────────────────────────
DEFAULT_TICKER=NFLX
