# Copy this to .env and fill in your values
# Never commit .env to git

# ── Data Sources ──────────────────────────────────────────────────────────────
# Alpha Vantage — free tier: 25 req/day, intraday + daily
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Alpaca Markets — free paper trading, minute bars
# Get keys at: https://app.alpaca.markets/paper-trading
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Broker Execution ──────────────────────────────────────────────────────────
# Set ALPACA_BASE_URL to live URL for real trading (use with extreme caution)
# ALPACA_BASE_URL=https://api.alpaca.markets

# ── Alerts & Monitoring ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
ALERT_EMAIL=alerts@yourdomain.com

# ── API Settings ──────────────────────────────────────────────────────────────
API_RATE_LIMIT=10
# JWT authentication: use a random secret of at least 32 characters for HS256.
# API_JWT_SECRET=replace-with-32-plus-random-bytes
# API_JWT_ALGORITHM=HS256
# API_JWT_ISSUER=alpha-engine
# API_JWT_AUDIENCE=alpha-engine-api
# API_USERS_JSON={"trader":{"password_hash":"salt$pbkdf2_sha256_hex","roles":["trader"]},"risk":{"password_hash":"salt$pbkdf2_sha256_hex","roles":["risk_analyst"]},"admin":{"password_hash":"salt$pbkdf2_sha256_hex","roles":["admin"]}}
# Docker Compose requires API_JWT_SECRET; set it to at least 32 random characters.
# Web cockpit: Next.js is published on ports 3000 and 3001, API on port 8000.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_LEGACY_UI_URL=http://localhost:8501
# NEXT_PUBLIC_DEMO_HLS_URL=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Redis Pub/Sub and live market events.
REDIS_URL=redis://localhost:6379/0
RISK_EVENTS_CHANNEL=alpha:risk:events

# Optional streaming-catalog ingestion (requires Kafka, Redis, and FFmpeg).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INTERACTIONS_KAFKA_TOPIC=netflix.user.interactions.v1
TELEMETRY_DLQ_TOPIC=netflix.telemetry.dlq
INTERACTIONS_CONSUMER_GROUP=netflix-interactions-v1
CATALOG_UPLOAD_DIR=data/catalog
CATALOG_MAX_UPLOAD_BYTES=2147483648
CATALOG_MAX_TEXT_BYTES=20971520
FFMPEG_BINARY=ffmpeg
# Qdrant semantic indexing is enabled when QDRANT_URL is configured.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=netflix_catalog
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RECOMMENDATION_COLLECTION=netflix_recommendations
CATALOG_COLLECTION=netflix_catalog
RECOMMENDATION_ARTIFACT_DIR=models/recommendations
RECOMMENDATION_LLM_MODEL=gpt-4o-mini

# ── Pipeline ──────────────────────────────────────────────────────────────────
DEFAULT_TICKER=NFLX

# ── AI Narrator / RAG System ─────────────────────────────────────────────────────
# OpenAI API key for LLM-powered narrative generation
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Langfuse for observability and tracing (optional)
# Get keys at: https://langfuse.com/
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
